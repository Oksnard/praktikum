{
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "AI_PROVIDER",
    "OPENAI_API_KEY",
    "DEEPSEEK_API_KEY",
    "PORT",
    "API_URL",
    "ALLOW_PUBLIC_REGISTRATION",
    "ALLOW_MOCK_TOPUPS",
    "MATERIAL_UPLOAD_DIR",
    "PUBLIC_ORIGIN"
  ]
}
