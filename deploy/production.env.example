NODE_ENV=production
DATABASE_URL=postgresql://praktikum:CHANGE_ME@127.0.0.1:5432/praktikum
API_URL=http://127.0.0.1:3311
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=CHANGE_ME
ALLOW_PUBLIC_REGISTRATION=false
# Enable only behind the required private HTTPS review gate for the trusted review owner.
ALLOW_MOCK_TOPUPS=true
# PORT is set independently in each systemd unit; do not put PORT here.
MATERIAL_UPLOAD_DIR=/opt/praktikum/data/uploads
