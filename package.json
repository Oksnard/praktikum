{
  "name": "praktikum",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "node --env-file=.env node_modules/turbo/bin/turbo run dev",
    "build": "turbo run build",
    "lint": "eslint apps packages",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @praktikum/api test",
    "test:e2e": "node --env-file=.env --import tsx apps/api/test/e2e.ts",
    "evals": "node --env-file=.env --import tsx apps/api/test/evals.ts",
    "db:generate": "pnpm --filter @praktikum/api exec prisma generate",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "node --env-file=.env --import tsx apps/api/prisma/seed.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "turbo": "^2.6.0",
    "prisma": "6.19.0",
    "@types/node": "^24.10.0",
    "@prisma/client": "6.19.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.48.0",
    "@eslint/js": "^9.39.0",
    "prettier": "^3.6.2"
  }
}
